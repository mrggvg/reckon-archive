# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Secrets and local config — .env.example files stay tracked
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage output
coverage/
.vitest/

# Tooling / assistant state
# (To share project-level Claude settings later, swap this for
#  `.claude/*` + `!.claude/settings.json` — a negation can't re-include a file
#  whose parent directory is excluded.)
.claude/
.cursor/
.aider*

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini
